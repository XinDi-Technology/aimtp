{
  "appId": "com.aimtp.converter",
  "productName": "Aimtp",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "!**/*.map",
    "!**/*.d.ts",
    "!tests/**/*",
    "!**/.DS_Store"
  ],
  "extraResources": [
    {
      "from": "src/fonts",
      "to": "dist/renderer/fonts"
    },
    {
      "from": "node_modules/pagedjs/dist/paged.js",
      "to": "paged.js"
    }
  ],
  "extraMetadata": {
    "main": "dist/main/main/main.js"
  },
  "asar": true,
  "asarUnpack": [],
  "compression": "maximum",
  "artifactName": "Aimtp-${version}-${os}-${arch}.${ext}",
  "win": { 
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Aimtp",
    "installerLanguages": ["zh_CN", "en_US"],
    "displayLanguageSelector": true,
    "uninstallDisplayName": "Aimtp",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "include": "build/uninstall-info.nsh"
  },
  "mac": { 
    "target": "dmg",
    "category": "public.app-category.productivity"
  },
  "linux": { 
    "target": "AppImage",
    "category": "Utility"
  },
  "publish": null
}
