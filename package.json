{
  "name": "Aimtp",
  "version": "0.2.25",
  "description": "专注合规的 Markdown 转 PDF 桌面应用",
  "main": "dist/main/main/main.js",
  "//": "dependencies 仅保留主进程运行时需要的 @cantoo/pdf-lib（main.ts 动态 import，PDF 元数据写入）。今后主进程新增 npm 依赖必须放回 dependencies，否则打包后运行时报 Cannot find module。渲染进程依赖一律放 devDependencies（vite 打进 bundle，不进 asar）",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "node scripts/build-pagedjs-iife.mjs && vite build",
    "dist": "npm run build && electron-builder",
    "test": "NODE_ENV=test playwright test",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XinDi-Technology/aimtp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  
  "bugs": {
    "url": "https://github.com/XinDi-Technology/aimtp/issues"
  },
  "homepage": "https://github.com/XinDi-Technology/aimtp#readme",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@eslint-react/eslint-plugin": "^5.24.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "electron": "^44.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "mathjax": "^4.1.3",
    "mermaid": "^12.1.0",
    "pagedjs": "0.5.0-beta.2",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}
